{"$id":"https://schemas.local/rad-pipeline/approval-v0.1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"A recorded authorization decision. CONTRACTS.md references approvals (cycle.approval_refs, finding.decision_refs, recorded release authority) but does not enumerate approval-record fields; this is a minimal field set, flagged as an open question in README-WP2.md.","properties":{"action":{"minLength":1,"type":"string"},"approval_id":{"minLength":1,"type":"string"},"approver":{"minLength":1,"type":"string"},"cycle_id":{"minLength":1,"type":"string"},"decided_at":{"format":"date-time","type":"string"},"decision":{"enum":["approved","denied"]},"evidence_refs":{"items":{"type":"string"},"type":"array"},"expires_at":{"format":"date-time","type":"string"},"project_id":{"minLength":1,"type":"string"},"rationale":{"type":"string"},"run_id":{"type":"string"},"schema_version":{"const":"0.1"},"scope":{"type":"string"},"stage_id":{"type":"string"}},"required":["schema_version","approval_id","project_id","cycle_id","action","decision","approver","decided_at"],"title":"RAD Pipeline Approval","type":"object"}